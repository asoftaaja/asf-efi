flowchart TD
    A([Power On / Reset]) --> B["loadFromEEPROM() — check each magic byte;\nwrite defaults if section uninitialised"]
    B --> B1["Main section (magic 0xB1):\nInjection map 10×4 (uint8, 100 µs/count)\nPID coefficients Kp / Ki / Kd (float32)\nPressure table: low bar, high bar, threshold RPM\nIAT correction 5 × Q8.8\nET correction 5 × Q8.8"]
    B1 --> B2["Axis section (magic 0xB2):\nRPM axis 10 × uint16\nTPS axis 4 × uint8"]
    B2 --> B3["Pump mode section (magic 0xA9):\n0 = PID (default), 1 = always-on"]
    B3 --> B4["TPS cal section (magic 0xAD):\nclosed ADC count, open ADC count"]
    B4 --> B5["Accel pump section (magic 0xAE):\nthreshold %/s, extra µs, duration ms"]
    B5 --> C["initCKPS():\nTimer1 normal mode, clk/8, falling-edge ICP\nenable input-capture and overflow interrupts"]
    C --> D["initInjection():\nD4 = OUTPUT, injector OFF\nD13 = OUTPUT, red LED OFF"]
    D --> E["initPump():\nD3 = OUTPUT, PWM = 0\nD12 = OUTPUT, green LED OFF"]
    E --> F["initComms():\nSerial.begin(115200)"]
    F --> G["Green LED D12 = HIGH\n(system initialised)"]
    G --> H([Enter Main Loop])
